From: Antigravity <antigravity@local>
Subject: [PATCH] usb: dwc3: restore ACPI host mode and select UTMI clock for QCOM0497

When booting via ACPI (e.g. Mu-Silicium UEFI), USB controller is described
as URS0 with HID QCOM0497.
Restore ACPI matching, release parent umbrella resource to avoid -EBUSY,
select UTMI clock to avoid PIPE clock timeout, and configure host mode
(dr_mode=host, maximum-speed=high-speed, vbus override) so USB keyboards
and devices enumerate and work out of the box under ACPI.

Signed-off-by: Antigravity <antigravity@local>
---
 drivers/usb/dwc3/core.c      | 14 +++++++++-
 drivers/usb/dwc3/dwc3-qcom.c | 95 ++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 105 insertions(+), 4 deletions(-)

--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -56,8 +56,12 @@ static int dwc3_get_dr_mode(struct dwc3 *dwc)
 	struct device *dev = dwc->dev;
 	unsigned int hw_mode;
 
-	if (dwc->dr_mode == USB_DR_MODE_UNKNOWN)
-		dwc->dr_mode = USB_DR_MODE_OTG;
+	if (dwc->dr_mode == USB_DR_MODE_UNKNOWN) {
+		if (has_acpi_companion(dev))
+			dwc->dr_mode = USB_DR_MODE_HOST;
+		else
+			dwc->dr_mode = USB_DR_MODE_OTG;
+	}
 
 	mode = dwc->dr_mode;
 	hw_mode = DWC3_GHWPARAMS0_MODE(dwc->hwparams.hwparams0);
@@ -1761,6 +1765,12 @@ static void dwc3_get_properties(struct dwc3 *dwc)
 	dwc->maximum_speed = usb_get_maximum_speed(dev);
 	dwc->max_ssp_rate = usb_get_maximum_ssp_rate(dev);
 	dwc->dr_mode = usb_get_dr_mode(dev);
+	if (has_acpi_companion(dev)) {
+		if (dwc->dr_mode == USB_DR_MODE_UNKNOWN)
+			dwc->dr_mode = USB_DR_MODE_HOST;
+		if (dwc->maximum_speed == USB_SPEED_UNKNOWN)
+			dwc->maximum_speed = USB_SPEED_HIGH;
+	}
 	dwc->hsphy_mode = of_usb_get_phy_mode(dev->of_node);
 
 	dwc->sysdev_is_parent = device_property_read_bool(dev,
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -20,8 +20,21 @@
 #include <linux/usb/hcd.h>
 #include <linux/usb.h>
 #include "core.h"
+#include <linux/acpi.h>
+#include <linux/property.h>
 #include "glue.h"
 
+#ifdef CONFIG_ACPI
+static const struct property_entry dwc3_acpi_host_props[] = {
+	PROPERTY_ENTRY_STRING("dr_mode", "host"),
+	PROPERTY_ENTRY_STRING("maximum-speed", "high-speed"),
+	PROPERTY_ENTRY_BOOL("qcom,select-utmi-as-pipe-clk"),
+	PROPERTY_ENTRY_BOOL("snps,has-lpm-erratum"),
+	PROPERTY_ENTRY_BOOL("snps,usb3-u1u2-disable"),
+	{ }
+};
+#endif
+
 /* USB QSCRATCH Hardware registers */
 #define QSCRATCH_HS_PHY_CTRL			0x10
 #define UTMI_OTG_VBUS_VALID			BIT(20)
@@ -132,6 +145,9 @@ static int dwc3_qcom_interconnect_enable(struct dwc3_qcom *qcom)
 {
 	int ret;
 
+	if (has_acpi_companion(qcom->dev))
+		return 0;
+
 	ret = icc_enable(qcom->icc_path_ddr);
 	if (ret)
 		return ret;
@@ -147,6 +163,9 @@ static int dwc3_qcom_interconnect_disable(struct dwc3_qcom *qcom)
 {
 	int ret;
 
+	if (has_acpi_companion(qcom->dev))
+		return 0;
+
 	ret = icc_disable(qcom->icc_path_ddr);
 	if (ret)
 		return ret;
@@ -170,6 +189,9 @@ static int dwc3_qcom_interconnect_init(struct dwc3_qcom *qcom)
 	struct device *dev = qcom->dev;
 	int ret;
 
+	if (has_acpi_companion(dev))
+		return 0;
+
 	qcom->icc_path_ddr = of_icc_get(dev, "usb-ddr");
 	if (IS_ERR(qcom->icc_path_ddr)) {
 		return dev_err_probe(dev, PTR_ERR(qcom->icc_path_ddr),
@@ -624,35 +646,37 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 
 	qcom->dev = &pdev->dev;
 
-	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
-	if (IS_ERR(qcom->resets)) {
-		return dev_err_probe(&pdev->dev, PTR_ERR(qcom->resets),
-				     "failed to get resets\n");
-	}
+	if (!has_acpi_companion(dev)) {
+		qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
+		if (IS_ERR(qcom->resets)) {
+			return dev_err_probe(&pdev->dev, PTR_ERR(qcom->resets),
+					     "failed to get resets\n");
+		}
+
+		ret = devm_clk_bulk_get_all(&pdev->dev, &qcom->clks);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "failed to get clocks\n");
+		qcom->num_clocks = ret;
+
+		ret = reset_control_assert(qcom->resets);
+		if (ret) {
+			dev_err(&pdev->dev, "failed to assert resets, err=%d\n", ret);
+			return ret;
+		}
 
-	ret = devm_clk_bulk_get_all(&pdev->dev, &qcom->clks);
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "failed to get clocks\n");
-	qcom->num_clocks = ret;
+		usleep_range(10, 1000);
 
-	ret = reset_control_assert(qcom->resets);
-	if (ret) {
-		dev_err(&pdev->dev, "failed to assert resets, err=%d\n", ret);
-		return ret;
-	}
-
-	usleep_range(10, 1000);
+		ret = reset_control_deassert(qcom->resets);
+		if (ret) {
+			dev_err(&pdev->dev, "failed to deassert resets, err=%d\n", ret);
+			return ret;
+		}
 
-	ret = reset_control_deassert(qcom->resets);
-	if (ret) {
-		dev_err(&pdev->dev, "failed to deassert resets, err=%d\n", ret);
-		return ret;
+		ret = clk_bulk_prepare_enable(qcom->num_clocks, qcom->clks);
+		if (ret < 0)
+			return ret;
 	}
 
-	ret = clk_bulk_prepare_enable(qcom->num_clocks, qcom->clks);
-	if (ret < 0)
-		return ret;
-
 	r = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	if (!r) {
 		ret = -EINVAL;
@@ -661,6 +685,15 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	res = *r;
 	res.end = res.start + SDM845_QSCRATCH_BASE_OFFSET;
 
+	if (has_acpi_companion(dev)) {
+		/*
+		 * Release the ACPI umbrella memory resource from iomem_resource
+		 * so that dwc3_core_probe() and xhci-plat can claim their respective
+		 * non-overlapping sub-regions without -EBUSY.
+		 */
+		release_resource(r);
+	}
+
 	qcom->qscratch_base = devm_ioremap(dev, res.end, SDM845_QSCRATCH_SIZE);
 	if (!qcom->qscratch_base) {
 		dev_err(dev, "failed to map qscratch region\n");
@@ -668,10 +701,12 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 		goto clk_disable;
 	}
 
-	ret = dwc3_qcom_setup_irq(qcom, pdev);
-	if (ret) {
-		dev_err(dev, "failed to setup IRQs, err=%d\n", ret);
-		goto clk_disable;
+	if (!has_acpi_companion(dev)) {
+		ret = dwc3_qcom_setup_irq(qcom, pdev);
+		if (ret) {
+			dev_err(dev, "failed to setup IRQs, err=%d\n", ret);
+			goto clk_disable;
+		}
 	}
 
 	/*
@@ -680,22 +715,59 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	 */
 	ignore_pipe_clk = device_property_read_bool(dev,
 				"qcom,select-utmi-as-pipe-clk");
-	if (ignore_pipe_clk)
+	if (has_acpi_companion(dev) || ignore_pipe_clk)
 		dwc3_qcom_select_utmi_clk(qcom);
 
-	qcom->mode = usb_get_dr_mode(dev);
-
-	if (qcom->mode == USB_DR_MODE_HOST) {
+	if (has_acpi_companion(dev)) {
+		device_create_managed_software_node(dev, dwc3_acpi_host_props, NULL);
+		dwc3_qcom_select_utmi_clk(qcom);
+		qcom->mode = USB_DR_MODE_HOST;
 		qcom->current_role = USB_ROLE_HOST;
-	} else if (qcom->mode == USB_DR_MODE_PERIPHERAL) {
-		qcom->current_role = USB_ROLE_DEVICE;
 		dwc3_qcom_vbus_override_enable(qcom, true);
+#ifdef CONFIG_ACPI
+		{
+			int irq = platform_get_irq(pdev, 0);
+			if (irq < 0) {
+				struct fwnode_handle *fwh = fwnode_get_named_child_node(dev->fwnode, "USB0");
+				if (fwh) {
+					struct acpi_device *adev = to_acpi_device_node(fwh);
+					if (adev) {
+						struct platform_device *urs_usb = acpi_create_platform_device(adev, NULL);
+						if (!IS_ERR_OR_NULL(urs_usb))
+							irq = platform_get_irq(urs_usb, 0);
+					}
+					fwnode_handle_put(fwh);
+				}
+			}
+			if (irq < 0) {
+				irq = acpi_register_gsi(NULL, 0x11F, ACPI_LEVEL_SENSITIVE, ACPI_ACTIVE_HIGH);
+			}
+			if (irq > 0) {
+				struct resource r_irq = {
+					.start = irq,
+					.end = irq,
+					.flags = IORESOURCE_IRQ,
+				};
+				platform_device_add_resources(pdev, &r_irq, 1);
+			}
+			dev_info(dev, "dwc3-qcom: ACPI probe initialized, IRQ=%d\n", irq);
+		}
+#endif
 	} else {
-		if ((device_property_read_bool(dev, "usb-role-switch")) &&
-		    (usb_get_role_switch_default_mode(dev) == USB_DR_MODE_HOST))
+		qcom->mode = usb_get_dr_mode(dev);
+
+		if (qcom->mode == USB_DR_MODE_HOST) {
 			qcom->current_role = USB_ROLE_HOST;
-		else
+		} else if (qcom->mode == USB_DR_MODE_PERIPHERAL) {
 			qcom->current_role = USB_ROLE_DEVICE;
+			dwc3_qcom_vbus_override_enable(qcom, true);
+		} else {
+			if ((device_property_read_bool(dev, "usb-role-switch")) &&
+			    (usb_get_role_switch_default_mode(dev) == USB_DR_MODE_HOST))
+				qcom->current_role = USB_ROLE_HOST;
+			else
+				qcom->current_role = USB_ROLE_DEVICE;
+		}
 	}
 
 	qcom->dwc.glue_ops = &dwc3_qcom_glue_ops;
@@ -844,6 +916,17 @@ static const struct of_device_id dwc3_qcom_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, dwc3_qcom_of_match);
 
+#ifdef CONFIG_ACPI
+static const struct acpi_device_id dwc3_qcom_acpi_match[] = {
+	{ "QCOM0497" },
+	{ "QCOM2430" },
+	{ "QCOM0304" },
+	{ "QCOM04A6" },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, dwc3_qcom_acpi_match);
+#endif
+
 static struct platform_driver dwc3_qcom_driver = {
 	.probe		= dwc3_qcom_probe,
 	.remove		= dwc3_qcom_remove,
@@ -852,6 +935,7 @@ static struct platform_driver dwc3_qcom_driver = {
 		.name	= "dwc3-qcom",
 		.pm	= pm_ptr(&dwc3_qcom_dev_pm_ops),
 		.of_match_table	= dwc3_qcom_of_match,
+		.acpi_match_table = ACPI_PTR(dwc3_qcom_acpi_match),
 	},
 };
 
