From: Antigravity <antigravity@local>
Subject: [PATCH] geni: fix ACPI support for Qualcomm GENI I2C bus

On ACPI systems (e.g. Mu-Silicium UEFI), Qualcomm GENI SE serial engine
clocks are unmanaged by devicetree clock framework.
In qcom-geni-se.c, devm_clk_get() fails with -ENOENT on ACPI, leaving
se->clk as an ERR_PTR. Calling clk_get_rate(gi2c->se.clk) in
i2c-qcom-geni.c subsequently causes a NULL/ERR pointer dereference and
kernel panic during probe.

Fix this by:
1. Setting se->clk = NULL on ACPI when devm_clk_get() fails.
2. Checking !IS_ERR_OR_NULL(gi2c->se.clk) before calling clk_get_rate().
3. Enforcing FIFO mode on ACPI to prevent probe failure looking for DMA.
4. Defaulting tx_depth safely if hardware register reads 0.
5. Printing informative dev_info log when adapter successfully probes.

Signed-off-by: Antigravity <antigravity@local>
---
 drivers/i2c/busses/i2c-qcom-geni.c | 10 +++++-----
 drivers/soc/qcom/qcom-geni-se.c    |  9 +++++++--
 2 files changed, 12 insertions(+), 7 deletions(-)

--- a/drivers/i2c/busses/i2c-qcom-geni.c
+++ b/drivers/i2c/busses/i2c-qcom-geni.c
@@ -198,7 +198,7 @@ static int geni_i2c_clk_map_idx(struct geni_i2c_dev *gi2c)
 {
 	const struct geni_i2c_clk_fld *itr;
 
-	if (clk_get_rate(gi2c->se.clk) == 32 * HZ_PER_MHZ)
+	if (!IS_ERR_OR_NULL(gi2c->se.clk) && clk_get_rate(gi2c->se.clk) == 32 * HZ_PER_MHZ)
 		itr = geni_i2c_clk_map_32mhz;
 	else
 		itr = geni_i2c_clk_map_19p2mhz;
@@ -1058,7 +1058,7 @@ static int geni_i2c_init(struct geni_i2c_dev *gi2c)
 		goto err;
 	}
 
-	if (gi2c->dev_data->no_dma_support) {
+	if (gi2c->dev_data->no_dma_support || has_acpi_companion(gi2c->se.dev)) {
 		fifo_disable = false;
 		gi2c->no_dma = true;
 	} else {
@@ -1078,8 +1078,8 @@ static int geni_i2c_init(struct geni_i2c_dev *gi2c)
 		tx_depth = geni_se_get_tx_fifo_depth(&gi2c->se);
 
 		/* I2C Master Hub Serial Elements doesn't have the HW_PARAM_0 register */
-		if (!tx_depth && gi2c->se.core_clk)
-			tx_depth = gi2c->dev_data->tx_fifo_depth;
+		if (!tx_depth)
+			tx_depth = gi2c->dev_data->tx_fifo_depth ? : 16;
 
 		if (!tx_depth) {
 			ret = dev_err_probe(gi2c->se.dev, -EINVAL,
@@ -1192,7 +1192,7 @@ static int geni_i2c_probe(struct platform_device *pdev)
 	if (ret)
 		return dev_err_probe(dev, ret, "Error adding i2c adapter\n");
 
-	dev_dbg(dev, "Geni-I2C adaptor successfully added\n");
+	dev_info(dev, "Geni-I2C adapter %s successfully added\n", gi2c->adap.name);
 
 	return 0;
 }
--- a/drivers/soc/qcom/qcom-geni-se.c
+++ b/drivers/soc/qcom/qcom-geni-se.c
@@ -1203,9 +1203,13 @@ int geni_se_resources_init(struct geni_se *se)
 				     "Failed to get optional core clk\n");
 
 	se->clk = devm_clk_get(se->dev, "se");
-	if (IS_ERR(se->clk) && !has_acpi_companion(se->dev))
-		return dev_err_probe(se->dev, PTR_ERR(se->clk),
-				     "Failed to get SE clk\n");
+	if (IS_ERR(se->clk)) {
+		if (has_acpi_companion(se->dev))
+			se->clk = NULL;
+		else
+			return dev_err_probe(se->dev, PTR_ERR(se->clk),
+					     "Failed to get SE clk\n");
+	}
 
 	ret = devm_pm_opp_set_clkname(se->dev, "se");
 	if (ret)
